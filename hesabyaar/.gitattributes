# Normalize all text files to LF in the repository and working tree.
* text=auto eol=lf

# Windows scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets (never normalize).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.jar binary
*.keystore binary
*.jks binary
*.so binary
*.dll binary
*.apk binary
*.aab binary
*.ttf binary
*.otf binary
